---
// Der Blütenbogen aus dem Logo als Trenner.
const punkte = [
  { x: 43, y: 23.8, w: -28 }, { x: 76, y: 17.2, w: -18 }, { x: 120, y: 14, w: 0 },
  { x: 164, y: 17.2, w: 18 }, { x: 197, y: 23.8, w: 28 },
];
---
<svg class="bogen" viewBox="0 0 240 42" width="240" height="42" fill="none" stroke="currentColor"
  stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
  <path d="M10 34 Q120 -6 230 34" />
  {punkte.map((p) => (
    <g transform={`translate(${p.x} ${p.y}) rotate(${p.w})`} fill="currentColor" stroke="none">
      <circle r="3.200" />
      <ellipse cx="-6.500" cy="2.200" rx="3.600" ry="1.500" transform="rotate(-24 -6.500 2.200)" />
      <ellipse cx="6.500" cy="2.200" rx="3.600" ry="1.500" transform="rotate(24 6.500 2.200)" />
    </g>
  ))}
</svg>
