---
// Polaroid-Rahmen. Solange kein Foto da ist, zeigt er eine Zeichnung und "Foto folgt".
import Zeichnung from './Zeichnung.astro';
interface Props {
  zeichnung?: 'baumwolle' | 'stoff' | 'holz' | 'garn' | 'gips' | 'herz';
  unterschrift?: string;
  dreh?: number;
  verkauft?: boolean;
}
const { zeichnung = 'baumwolle', unterschrift, dreh = 0, verkauft = false } = Astro.props;
---
<figure class="foto" style={`--dreh:${dreh}deg`}>
  <div class="foto-flaeche">
    <Zeichnung name={zeichnung} groesse={72} />
    <span class="foto-hinweis">Foto folgt</span>
    {verkauft && <span class="verkauft">Verkauft</span>}
  </div>
  {unterschrift && <figcaption>{unterschrift}</figcaption>}
</figure>
